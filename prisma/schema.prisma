// Money is always stored as integer cents (100 cents = 1 €).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HOTEL_OWNER
}

enum StockState {
  NONE
  AVAILABLE
  AT_HOTEL
  WASHING
  WRITTEN_OFF
}

// STOCK_IN, WASHED, LOST and DAMAGED are no longer created (stock is managed by hand),
// but stay so older rows remain readable.
enum MovementType {
  STOCK_IN
  SEND
  SEND_VOID
  RETURN
  REJECT
  WASHED
  LOST
  DAMAGED
}

enum HotelItemMovementType {
  COLLECTED
  DELIVERED
}

enum DiscountType {
  NONE
  PERCENT
  FLAT
}

enum LedgerType {
  CHARGE
  PAYMENT
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  BANK
  EMPLOYEE
  POS
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOIDED
}

enum RecordStatus {
  ACTIVE
  VOIDED
}

// ---------- Users and auth ----------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions  Session[]
  customer  Customer?
  auditLogs AuditLog[]
}

model Session {
  // sha256 of the random token stored in the cookie
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------- Catalog and stock ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  basePrice  Int
  photoPath  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  hotelPrices    HotelPrice[]
  stockMovements StockMovement[]
  sendLines      SendLine[]
  hotelItems     HotelItemMovement[]

  @@unique([categoryId, name])
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  hotelId     String?
  type        MovementType
  fromState   StockState
  toState     StockState
  quantity    Int
  // groups the rows created by one action (one return, one send, ...)
  batchId     String
  sendId      String?
  note        String?
  createdById String
  createdAt   DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  hotel   Hotel?  @relation(fields: [hotelId], references: [id])
  send    Send?   @relation(fields: [sendId], references: [id])

  @@index([productId, hotelId])
  @@index([hotelId, createdAt])
  @@index([batchId])
}

// ---------- Customers and hotels ----------

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String
  address   String?
  photoPath String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  hotels Hotel[]
}

model Hotel {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  location     String
  taxNo        String?
  tradeLicense String?
  email        String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer       Customer            @relation(fields: [customerId], references: [id])
  prices         HotelPrice[]
  sends          Send[]
  stockMovements StockMovement[]
  itemMovements  HotelItemMovement[]
  ledgerEntries  LedgerEntry[]
  invoices       Invoice[]

  @@index([customerId])
}

// The agreed deal: one ACTIVE row (validTo = null) per hotel + product.
model HotelPrice {
  id            String       @id @default(cuid())
  hotelId       String
  productId     String
  discountType  DiscountType
  // PERCENT: basis points (1000 = 10%), FLAT: cents per piece
  discountValue Int
  agreedPrice   Int
  validFrom     DateTime     @default(now())
  validTo       DateTime?
  createdById   String

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([hotelId, productId, validTo])
}

// ---------- Sends (rental, charged per piece) ----------

model Send {
  id             String       @id @default(cuid())
  hotelId        String
  subtotal       Int
  wholeDiscount  Int          @default(0)
  total          Int
  discountReason String?
  note           String?
  status         RecordStatus @default(ACTIVE)
  voidReason     String?
  voidedAt       DateTime?
  createdById    String
  createdAt      DateTime     @default(now())

  hotel          Hotel               @relation(fields: [hotelId], references: [id])
  lines          SendLine[]
  itemLines      HotelItemMovement[]
  stockMovements StockMovement[]
  ledgerEntries  LedgerEntry[]
  invoiceId      String?
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id])

  @@index([hotelId, createdAt])
}

model SendLine {
  id                    String @id @default(cuid())
  sendId                String
  productId             String
  quantity              Int
  basePriceSnapshot     Int
  agreedPriceSnapshot   Int
  extraDiscountPerPiece Int    @default(0)
  finalUnitPrice        Int
  lineTotal             Int

  send    Send    @relation(fields: [sendId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// The hotel's OWN pieces we wash. COLLECTED on the Collect screen; DELIVERED
// (with the washing price typed at the time) as part of a Send.
// Either one of our product types (productId) or a free name ("Other").
// Items with us = collected - delivered (delivered rows of voided sends don't count).
model HotelItemMovement {
  id                String                @id @default(cuid())
  hotelId           String
  productId         String?
  itemName          String
  type              HotelItemMovementType
  quantity          Int
  unitPriceSnapshot Int                   @default(0)
  lineTotal         Int                   @default(0)
  sendId            String?
  batchId           String
  note              String?
  createdById       String
  createdAt         DateTime              @default(now())

  hotel   Hotel    @relation(fields: [hotelId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  send    Send?    @relation(fields: [sendId], references: [id])

  @@index([hotelId, productId])
  @@index([hotelId, itemName])
  @@index([batchId])
}

// ---------- Money ----------

// CHARGE and PAYMENT amounts are positive. ADJUSTMENT is signed:
// positive increases the due, negative decreases it.
model LedgerEntry {
  id             String         @id @default(cuid())
  hotelId        String
  type           LedgerType
  amount         Int
  date           DateTime
  method         PaymentMethod?
  note           String?
  sendId         String?
  // groups a credit with the Collect action that created it
  batchId        String?
  // rejected-piece credits included in an invoice, and the payment made when it is marked paid
  invoiceId      String?
  status         RecordStatus   @default(ACTIVE)
  voidReason     String?
  createdById    String
  createdAt      DateTime       @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])
  send    Send?    @relation(fields: [sendId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([hotelId, date])
  @@index([type, date])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id          String   @id @default(cuid())
  categoryId  String
  amount      Int
  paidAt      DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([paidAt])
}

// ---------- Invoices (fatture) ----------

// Built from a hotel's sends (and rejected-piece credits) in a chosen period.
// Number restarts every year: 1/2026, 2/2026, ...
model Invoice {
  id          String         @id @default(cuid())
  year        Int
  number      Int
  hotelId     String
  periodFrom  DateTime
  // exclusive end
  periodTo    DateTime
  issuedAt    DateTime       @default(now())
  total       Int
  status      InvoiceStatus  @default(UNPAID)
  paidAt      DateTime?
  method      PaymentMethod?
  note        String?
  voidReason  String?
  createdById String

  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  lines         InvoiceLine[]
  sends         Send[]
  ledgerEntries LedgerEntry[]

  @@unique([year, number])
  @@index([hotelId, issuedAt])
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Int
  total       Int
  sortOrder   Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ---------- Settings ----------

// Simple key/value store, e.g. company details printed on invoices.
model Setting {
  key   String @id
  value String
}
