# Neon: use the pooled connection string here...
# (If you ever see "prepared statement already exists" errors, add &pgbouncer=true.)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/annafi?sslmode=require"
# ...and the direct (non-pooled) one here, used by migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/annafi?sslmode=require"

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Admin"

# Gmail with an app password (Google Account > Security > 2-Step Verification > App passwords).
# If these are empty, emails are printed to the server console instead of sent.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Public URL of the app, used in email links.
APP_URL="http://localhost:3000"
